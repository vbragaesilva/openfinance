# Copie para .env. Sem TURSO_DATABASE_URL, o dev usa file:local.db.
# TURSO_DATABASE_URL=libsql://openfinance-SEU-USUARIO.turso.io
# TURSO_AUTH_TOKEN=

# Login do app. No dev, sem APP_PASSWORD o app abre sem senha.
# APP_PASSWORD=
# SESSION_SECRET=   # gere com: openssl rand -base64 32

# Chave para os Atalhos do iPhone (Authorization: Bearer ...). Gere com: openssl rand -hex 32
# API_TOKEN=
